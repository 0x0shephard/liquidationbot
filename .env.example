# ============================================================================
# RPC
# ============================================================================
# An archive-capable RPC is REQUIRED. The bot backfills TradeExecuted logs from
# the deployment block, and public endpoints (e.g. publicnode) reject historical
# eth_getLogs with "Archive requests require a personal token".
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ============================================================================
# CONTRACTS (Sepolia - deployments/sepolia-addresses.md)
# ============================================================================
# Defaults are the live deployment; override only if you redeploy.
# CLEARING_HOUSE_ADDRESS must be the PROXY, not the implementation.
CLEARING_HOUSE_ADDRESS=0xDf4DDD4019097B335dD507f916984A1A53E40a0d
MARKET_REGISTRY_ADDRESS=0x236b75D39203506ee3180Ef2E1c7460a188C43c6

# Per-market vAMM / oracle / feeRouter are read from the MarketRegistry at
# runtime, so they are not configured here.

# Optional comma-separated market allowlist. Empty = watch every market.
# e.g. B200-PERP-V2 and AWS-H100-PERP:
# MARKET_IDS=0x02164b06b5fff171a87dbb519e6d639871a0cfbc0e44d411313256d0168b60fe,0x69df00e859e1b007896c59653bb3ca35622fdf2bf46c2fd9fea7ffa7d88b6378

# First block to index. Default is the earliest Sepolia deployment receipt.
# Raising this makes bootstrap much faster if you don't need old positions.
START_BLOCK=10797215
LOG_CHUNK_SIZE=10000

# ============================================================================
# EXECUTION
# ============================================================================
# The liquidator address MUST be whitelisted on-chain. An admin has to call:
#   clearingHouse.setWhitelistedLiquidator(<yourAddress>, true)
# The bot checks this at startup and refuses to run in execute mode without it.
PRIVATE_KEY=0xCc624fFA5df1F3F4b30aa8abd30186a86254F406

# false = monitor and alert only (default, safe)
# true  = execute liquidations
EXECUTE_MODE=false

# true = run every check and simulation, price the trade, but never send a tx
DRY_RUN=false

GAS_LIMIT=3000000

# liquidate() takes an amountLimit that guards the vAMM leg against slippage.
#   zero = no guard (default; the position is already underwater)
#   mark = derive the limit from the mark price using SLIPPAGE_BPS
AMOUNT_LIMIT_MODE=zero
SLIPPAGE_BPS=50

# ============================================================================
# PROFITABILITY
# ============================================================================
# The liquidator's reward is:
#   penalty = min(notional * liquidationPenaltyBps / 10000, penaltyCap)
#   reward  = feeRouter set ? penalty / 2 : penalty
# All three inputs are read from chain. On the current Sepolia markets that is
# 250 bps, a 1000e18 cap, and a FeeRouter - so the reward is capped at ~500
# quote units per liquidation no matter how large the position.
MIN_LIQUIDATION_REWARD_USD=10
MAX_GAS_PRICE_GWEI=50

# Set to 'false' to liquidate every position the simulation accepts, even at a
# net loss. Sensible on testnet, where gas is free and clearing bad debt is the
# point. On mainnet this gives away value on every dust position - leave it true.
REQUIRE_PROFITABLE=true

# Gas is paid in ETH, rewards are paid in the quote token. These are GPU compute
# perps, so no market's price tells you anything about ETH - it must come from
# outside. Used only to convert gas into USD for the profitability check.
ETH_PRICE_USD=3000

# ============================================================================
# BOT
# ============================================================================
POLLING_INTERVAL_MS=30000
FUNDING_POKE_INTERVAL_MS=3600000
MAX_POSITIONS_PER_SCAN=250
RPC_RETRIES=5
RPC_RETRY_DELAY_MS=2000

# ============================================================================
# SENDGRID (optional - falls back to console logging)
# ============================================================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@yourdomain.com
ALERT_RECIPIENT_EMAIL=
